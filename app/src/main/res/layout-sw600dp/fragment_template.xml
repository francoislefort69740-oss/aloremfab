<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".fragment.TemplateFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.example.myapplication.canvas.ADRReportGRV
            android:id="@+id/adr_report_template"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <com.example.myapplication.canvas.FloatingNameGRVReport
            android:id="@+id/adr_report_floating_name"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/template_guideline_1_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.90"/>

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/template_guideline_2_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.95"/>


        <ImageView
            android:id="@+id/template_right_arrow"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/iaphotologo"
            android:src="@drawable/baseline_arrow_right_24"
            app:layout_constraintBottom_toTopOf="@+id/template_guideline_2_menu"
            app:layout_constraintDimensionRatio="h,1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/template_guideline_1_menu" />

        <ImageView
            android:id="@+id/template_arrow_down"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/iaphotologo"
            android:src="@drawable/baseline_arrow_drop_down_24"
            app:layout_constraintBottom_toTopOf="@+id/template_guideline_2_menu"
            app:layout_constraintDimensionRatio="h,1:1"
            app:layout_constraintEnd_toStartOf="@+id/template_right_arrow"
            app:layout_constraintTop_toTopOf="@+id/template_guideline_1_menu" />

        <ImageView
            android:id="@+id/template_up_arrow"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/iaphotologo"
            android:src="@drawable/baseline_arrow_drop_up_24"
            app:layout_constraintBottom_toTopOf="@+id/template_guideline_2_menu"
            app:layout_constraintDimensionRatio="h,1:1"
            app:layout_constraintEnd_toStartOf="@+id/template_arrow_down"
            app:layout_constraintTop_toTopOf="@+id/template_guideline_1_menu" />

        <ImageView
            android:id="@+id/template_left_arrow"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/iaphotologo"
            android:src="@drawable/outline_arrow_left_24"
            app:layout_constraintBottom_toTopOf="@+id/template_guideline_2_menu"
            app:layout_constraintDimensionRatio="h,1:1"
            app:layout_constraintEnd_toStartOf="@+id/template_up_arrow"
            app:layout_constraintTop_toTopOf="@+id/template_guideline_1_menu" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/template_back_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/iaphotologo"
            android:padding="20dp"
            android:text="@string/back"
            android:textColor="@color/black"
            app:backgroundTint="@null"
            app:layout_constraintBottom_toTopOf="@+id/template_guideline_2_menu"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/template_guideline_1_menu" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/template_validate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:background="@drawable/iaphotologo"
            android:padding="20dp"
            android:text="@string/validate"
            android:textColor="@color/black"
            app:backgroundTint="@null"
            app:layout_constraintBottom_toTopOf="@+id/template_guideline_2_menu"
            app:layout_constraintStart_toEndOf="@+id/template_back_menu"
            app:layout_constraintTop_toTopOf="@+id/template_guideline_1_menu" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/template_ladder_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/iaphotologo"
            android:padding="20dp"
            android:text="@string/Defaut_ladder_GRV_template"
            android:textColor="@color/black"
            app:backgroundTint="@null"
            app:layout_constraintBottom_toTopOf="@+id/template_guideline_2_menu"
            app:layout_constraintEnd_toStartOf="@+id/template_left_arrow"
            app:layout_constraintStart_toEndOf="@+id/template_validate"
            app:layout_constraintTop_toTopOf="@+id/template_guideline_1_menu" />


    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>